# Optional: Mormey dialogue generation. Empty means deterministic local fallback.
ANTHROPIC_API_KEY=

# Spring 학습 백엔드 주소, 예: http://localhost:8080
# 비어 있으면 모든 서버 호출이 꺼지고 화면은 localStorage 로만 동작한다(로컬 데모).
NEXT_PUBLIC_API_BASE_URL=

# Optional PostHog product analytics. Empty means analytics is disabled.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
