# Mormi-AI 대화 서비스. 둘 다 서버 전용이며 브라우저 번들에 들어가지 않는다.
# 배포: http://<AI EC2 퍼블릭 IP>:8000   로컬: http://localhost:8000
# 서비스 키는 AI 쪽 MORMI_SERVICE_API_KEY 와 같은 값을 쓴다.
# 비어 있으면 대화가 아래 ANTHROPIC_API_KEY 경로로 내려간다.
AI_ORIGIN=
MORMI_DIALOGUE_SERVICE_KEY=

# Mormi-AI 가 아직 다루지 않는 세션의 대화용 폴백. 비어 있으면 하드코딩 문장으로 동작한다.
# AI 에 시나리오가 모두 옮겨지면 이 키는 제거한다.
ANTHROPIC_API_KEY=

# Spring 학습 백엔드 주소. 서버 전용이며 브라우저 번들에 들어가지 않는다.
# 배포: http://<EC2 퍼블릭 IP>:8080   로컬: http://localhost:8080
# next.config.ts 의 /api/be/* 프록시가 이 주소로 요청을 넘긴다.
BACKEND_ORIGIN=

# 프런트가 사용할 API 경로. 위 프록시를 쓰면 상대 경로 그대로 둔다.
# 비어 있으면 모든 서버 호출이 꺼지고 화면은 localStorage 로만 동작한다(로컬 데모).
NEXT_PUBLIC_API_BASE_URL=/api/be

# Optional PostHog product analytics. Empty means analytics is disabled.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
