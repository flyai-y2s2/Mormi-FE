# Mormi-AI dialogue service. Both naming pairs are server-only aliases.
# Preferred shared-deployment names:
AI_ORIGIN=http://localhost:8000
MORMI_DIALOGUE_SERVICE_KEY=
# Compatibility names used by the stateful /api/mormi/* BFF:
MORMI_AI_BASE_URL=http://localhost:8000
MORMI_AI_SERVICE_KEY=

# Legacy one-turn dialogue fallback. Remove after every teaching scene uses Mormi-AI.
ANTHROPIC_API_KEY=

# Spring learning backend. BACKEND_ORIGIN stays server-only.
BACKEND_ORIGIN=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=/api/be

# /ai-test is available in development. Keep false on the child-test deployment.
MORMI_ENABLE_AI_TEST_PAGE=false

# Optional PostHog product analytics. Empty means analytics is disabled.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
