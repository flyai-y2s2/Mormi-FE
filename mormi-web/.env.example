# Spring learning backend. Required: use the deployed HTTPS address only.
# This value stays on the Next.js server and is never exposed to the browser.
BACKEND_ORIGIN=https://YOUR-DEPLOYED-SPRING-BE.example.com

# Mormi-AI dialogue service. These are server-only settings for the temporary
# /api/mormi/* development BFF; production dialogue should flow through Spring BE.
# Use a deployed AI address by default. Keep service-key values only in .env.local
# or the deployment environment; never commit actual keys.
MORMI_AI_BASE_URL=https://YOUR-DEPLOYED-MORMI-AI.example.com
MORMI_AI_SERVICE_KEY=

# Set true only when scripts/start-local-stack.sh should start local Mormi-AI
# for the /ai-test page. This does not start a local Spring BE.
MORMI_START_LOCAL_AI=false
AI_ORIGIN=http://127.0.0.1:8000
MORMI_DIALOGUE_SERVICE_KEY=

# Legacy one-turn dialogue fallback. Keep the real key only in server-side env.
ANTHROPIC_API_KEY=

# /ai-test is available in development. Keep false on the child-test deployment.
MORMI_ENABLE_AI_TEST_PAGE=false

# Teacher report proxy. Local development may use the loopback origin without a
# password. Production requires BACKEND_ORIGIN (or an HTTPS override below), a
# strong teacher password, and a session secret of at least 32 characters.
ENABLE_LOCAL_REPORT_ADMIN=false
LOCAL_REPORT_ADMIN_ORIGIN=http://127.0.0.1:8080
LOCAL_REPORT_ADMIN_KEY=
# Use at least 12 characters. Failed attempts are limited per anonymized client
# by the deployed backend, while the password itself remains only in Vercel.
TEACHER_REPORT_PASSWORD=
TEACHER_REPORT_SESSION_SECRET=

# Optional PostHog product analytics. Empty means analytics is disabled.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
